module Thesis.List where

open import Thesis.Equality
open import Thesis.Bool
open import Thesis.Nat

-- Finite sequences. Recursion on a list is the induction principle used for
-- counts, sums, and concatenations. The element type is arbitrary; no
-- equality of elements is required until a particular theorem asks for it.

data List (A : Set) : Set where
  []  : List A
  _∷_ : A → List A → List A

infixr 5 _∷_

length : {A : Set} → List A → ℕ
length []       = zero
length (_ ∷ xs) = suc (length xs)

map : {A B : Set} → (A → B) → List A → List B
map f []       = []
map f (x ∷ xs) = f x ∷ map f xs

_++_ : {A : Set} → List A → List A → List A
[]       ++ ys = ys
(x ∷ xs) ++ ys = x ∷ (xs ++ ys)

infixr 5 _++_

-- Concatenate the lists produced by a family. The outer list chooses which
-- family member is read; nothing is dropped and nothing is invented.
flatMap : {A B : Set} → (A → List B) → List A → List B
flatMap f []       = []
flatMap f (x ∷ xs) = f x ++ flatMap f xs

sum : List ℕ → ℕ
sum []       = zero
sum (n ∷ ns) = n + sum ns

-- Every element of a list satisfies `P`.
data All {A : Set} (P : A → Set) : List A → Set where
  []  : All P []
  _∷_ : ∀ {x xs} → P x → All P xs → All P (x ∷ xs)

-- Consecutive elements stand in `R`, including every earlier element with
-- every later one. The head clause is an `All`, so the relation reaches the
-- whole tail, not only neighbours.
data Pairwise {A : Set} (R : A → A → Set) : List A → Set where
  []  : Pairwise R []
  _∷_ : ∀ {x xs} → All (R x) xs → Pairwise R xs → Pairwise R (x ∷ xs)

-- One entry contributes a unit when the test holds, and nothing otherwise.
extra : Bool → ℕ
extra true  = suc zero
extra false = zero

-- Count the entries on which a Boolean test returns `true`. The test is
-- applied once at each cons cell.
countP : {A : Set} → (A → Bool) → List A → ℕ
countP _ []       = zero
countP p (x ∷ xs) = extra (p x) + countP p xs

countP-top : {A : Set} (xs : List A) →
             countP (λ _ → true) xs ≡ length xs
countP-top []       = refl
countP-top (x ∷ xs) rewrite countP-top xs = refl

countP-bottom : {A : Set} (xs : List A) →
                countP (λ _ → false) xs ≡ zero
countP-bottom []       = refl
countP-bottom (x ∷ xs) rewrite countP-bottom xs = refl

-- Pointwise agreement of tests is enough. The tests themselves are not
-- identified; only their values on the listed entries are used, and the
-- induction hypothesis carries the same agreement down the tail.
countP-cong : {A : Set} {p q : A → Bool} (xs : List A) →
              (∀ x → p x ≡ q x) → countP p xs ≡ countP q xs
countP-cong []       _ = refl
countP-cong (x ∷ xs) h rewrite h x | countP-cong xs h = refl

map-++ : {A B : Set} (f : A → B) (xs ys : List A) →
         map f (xs ++ ys) ≡ map f xs ++ map f ys
map-++ f []       ys = refl
map-++ f (x ∷ xs) ys rewrite map-++ f xs ys = refl

-- A map that agrees at every listed element produces the same list. The
-- induction is on the list, so the argument is only the elements that occur.
map-cong : {A B : Set} {f g : A → B} (xs : List A) →
           (∀ x → f x ≡ g x) → map f xs ≡ map g xs
map-cong []       _ = refl
map-cong (x ∷ xs) h rewrite h x | map-cong xs h = refl

countP-≤-length : {A : Set} (p : A → Bool) (xs : List A) →
                  countP p xs ≤ length xs
countP-≤-length p []       = z≤n
countP-≤-length p (x ∷ xs) with p x
... | false = ≤-step (countP-≤-length p xs)
... | true  = s≤s (countP-≤-length p xs)

-- A permutation is generated by inserting a common head, swapping the first
-- two entries, and composing such steps. It is an explicit finite witness
-- that two lists contain the same entries with the same multiplicities.
data Perm {A : Set} : List A → List A → Set where
  refl  : ∀ {xs} → Perm xs xs
  prep  : ∀ {x xs ys} → Perm xs ys → Perm (x ∷ xs) (x ∷ ys)
  swap  : ∀ {x y xs} → Perm (x ∷ y ∷ xs) (y ∷ x ∷ xs)
  comp  : ∀ {xs ys zs} → Perm xs ys → Perm ys zs → Perm xs zs

countP-swap : {A : Set} (p : A → Bool) (x y : A) (xs : List A) →
              countP p (x ∷ y ∷ xs) ≡ countP p (y ∷ x ∷ xs)
countP-swap p x y xs =
  begin
    extra (p x) + (extra (p y) + countP p xs)
  ≡⟨ sym (+-assoc (extra (p x)) (extra (p y)) (countP p xs)) ⟩
    (extra (p x) + extra (p y)) + countP p xs
  ≡⟨ cong (_+ countP p xs) (+-comm (extra (p x)) (extra (p y))) ⟩
    (extra (p y) + extra (p x)) + countP p xs
  ≡⟨ +-assoc (extra (p y)) (extra (p x)) (countP p xs) ⟩
    extra (p y) + (extra (p x) + countP p xs)
  ∎

-- Reordering a finite enumeration does not change how many entries pass a
-- Boolean test. The proof follows the permutation witness: a common head is
-- shared, an adjacent swap commutes the two contributions, and composition
-- chains the equalities.
countP-perm : {A : Set} {xs ys : List A} (p : A → Bool) →
              Perm xs ys → countP p xs ≡ countP p ys
countP-perm p refl           = refl
countP-perm p (prep perm)    rewrite countP-perm p perm = refl
countP-perm p (swap {x} {y} {xs}) = countP-swap p x y xs
countP-perm p (comp π ρ)     = trans (countP-perm p π) (countP-perm p ρ)
