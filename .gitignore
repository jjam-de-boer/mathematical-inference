# Lean
/.lake/
/code/lean/.lake/
/code/lean/lake-packages/

# Agda build interfaces
*.agdai
_build/

# LaTeX workspace: keep local sources/build products, track only the final PDFs.
/documents/thesis/*
!/documents/thesis/Thesis_Jelmer_de_Boer.pdf
!/documents/thesis/story.txt
/documents/book/*
!/documents/book/mathematical_inference.pdf

# Paper library
/papers/

# Archives
*.zip

# Generated local artifacts
/tmp/

# Python helper bytecode (code/lean/tools orchestration; not proofs)
__pycache__/
*.py[cod]

# Publish the README and shared agent instructions; ignore other Markdown.
*.[mM][dD]
!/README.md
!/code/lean/AGENTS.md

# LaTeX build products
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.bbl
*.blg
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.dvi
*.ps

# Editors / OS
.DS_Store
.vscode/
.idea/
