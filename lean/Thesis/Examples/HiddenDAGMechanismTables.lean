import Thesis.CausalTransport.HiddenDAGMechanismCatalogue
import Thesis.Examples.HiddenDAGFiniteRepresentation

namespace Thesis.Causality.Examples.HiddenDAGMechanismTables

open Probability HiddenDAGCollapse

/-!
# Native reconstruction and coverage of all bounded mechanism shapes

Use the existing five-node hidden relay's bounded representative. Its own
equations are tabulated explicitly, listed in the equation-independent shape
catalogue, and reconstructed as the identical native model. Whole-observation
and selected-effect preservation therefore still refer to actual native
records. The shared three-child ancestor and non-root hidden relay remain.

One tiny raw-shape test gives all non-root endogenous types zero codes. Those
are not asserted to form a native model; they test only that absent parents
with empty types do not erase a root's legitimate input row. The native
coverage tests remain symbolic, without expanding huge table catalogues.
-/

def represented := HiddenDAGFiniteRepresentation.witness

theorem every_table_of_this_shape_is_listed
    (tables : fullGraph.CodeMechanismTables represented.nodeCard represented.sourceCard) :
    tables ∈ fullGraph.codeMechanismCatalogue represented.nodeCard represented.sourceCard :=
  fullGraph.codeMechanismCatalogue_complete represented.nodeCard represented.sourceCard tables

theorem actual_table_is_listed :
    represented.mechanismTables ∈ fullGraph.codeMechanismCatalogue represented.nodeCard represented.sourceCard :=
  represented.mechanismTables_mem

theorem exact_native_reconstruction : represented.tabulatedModel = represented.model := represented.tabulatedModel_eq

theorem every_intervention_record_reconstructed (intervention : HardIntervention signature) :
    represented.tabulatedModel.interventionalDist intervention = represented.model.interventionalDist intervention :=
  congrArg (fun native => native.interventionalDist intervention) exact_native_reconstruction

theorem factual_law_preserved (event : Event signature.Assignment) :
    QProb.Equiv (represented.tabulatedModel.observationalValue event)
      (HiddenDAGSourceCompression.original.observationalValue event) := represented.tabulatedModel_observational event

theorem retained_effect_preserved :
    QProb.Equiv (represented.tabulatedModel.interventionalValue HiddenDAGSourceCompression.target.intervention HiddenDAGSourceCompression.target.event)
      (HiddenDAGSourceCompression.original.interventionalValue HiddenDAGSourceCompression.target.intervention HiddenDAGSourceCompression.target.event) :=
  represented.tabulatedModel_preserved _ List.mem_cons_self

/-- The *same* finite catalogue covers every original model at this graph
and target count; it is not generated by reading the represented equations. -/
theorem table_is_in_uniform_catalogue :
    represented.catalogueEntry ∈ fullGraph.boundedMechanismCatalogue
      (FiniteHiddenDAGSCM.representationNodeBound projection 1)
      (FiniteHiddenDAGSCM.representationSourceBound signature 1) := represented.catalogueEntry_mem

def rootOnlyCards (node : Fin fullGraph.count) : Nat := if node.val = 0 then 2 else 0

theorem absent_empty_nodes_do_not_erase_root_rows :
    (fullGraph.codeInputWitness rootOnlyCards (fun _ => 1) u).card = 1 := by decide +kernel

theorem root_has_two_local_tables :
    (fullGraph.codeLocalTables rootOnlyCards (fun _ => 1) u).length = 2 := by decide +kernel

end Thesis.Causality.Examples.HiddenDAGMechanismTables
