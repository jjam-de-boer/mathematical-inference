import Thesis.Causality.Model
import Thesis.Probability.FiniteProductSupport
import Thesis.Probability.FiniteUniformProduct

namespace Thesis
namespace Causality
namespace BinaryInstrumental

open Probability

/-!
# The sixteen response profiles for a binary instrumental-variable model

Observed nodes are ordered `Z,X,Y`, with arrows `Z -> X` and `X -> Y`.
The instrument will have its own independent source; the treatment and
outcome may share an unrestricted finite hidden source.  One response
profile stores the two treatment outputs indexed by `Z` and the two outcome
outputs indexed by `X`.  All sixteen profiles are permitted: in particular
there is no monotonicity assumption excluding the decreasing treatment map.

This module provides the complete finite data representation and its linear
probability equations.  A joint observed cell is the instrument probability
times the mass of profiles producing that treatment and outcome.  These
equations deliberately use joint cells, not division by instrument mass,
and therefore remain meaningful at zero-probability instrument values.

The forward data representation is not by itself a completeness theorem for
native hidden DAGs.  Subsequent work must construct actual compatible SCMs
and prove that every native model admits such an independent response-profile
representation before an optimizer over these weights can claim sharpness.
-/

def signature : ObservedSignature where
  count := 3
  Value := fun _ => Bool
  valueEnumeration := fun _ => [false, true]
  value_complete := by intro _ value; cases value <;> simp
  value_nodup := by intro _; simp
  defaultValue := fun _ => false
  valueDecidableEq := fun _ => inferInstance
  directed := fun parent child => decide
    ((parent.val = 0 ∧ child.val = 1) ∨ (parent.val = 1 ∧ child.val = 2))
  directed_earlier := by decide +kernel

def z : Fin signature.count := ⟨0, by decide⟩
def x : Fin signature.count := ⟨1, by decide⟩
def y : Fin signature.count := ⟨2, by decide⟩

/-- Four explicit bits: `X(0), X(1), Y(0), Y(1)`.  A constant, increasing,
or decreasing treatment response is represented without restriction. -/
abbrev Profile := Fin 4 → Bool

instance profileDecidableEq : DecidableEq Profile :=
  FiniteProduct.assignmentDecidableEq 4 (fun _ => Bool) (fun _ => inferInstance)

def profiles : List Profile :=
  FiniteProduct.enumeration 4 (fun _ => Bool) (fun _ => [false, true])

theorem profiles_complete (profile : Profile) : profile ∈ profiles :=
  FiniteProduct.enumeration_complete 4 (fun _ => Bool) (fun _ => [false, true])
    (by intro _ value; cases value <;> simp) profile

theorem profiles_nodup : profiles.Nodup :=
  FiniteProduct.enumeration_nodup 4 (fun _ => Bool) (fun _ => [false, true])
    (fun _ => inferInstance)
    (by intro _; change ([false, true] : List Bool).Nodup; decide +kernel)

/-- Only this small data catalogue is reduced to establish its literal size.
No model, unknown probability parameter, or optimization problem is reduced. -/
theorem profiles_length : profiles.length = 16 := by decide +kernel

def treatmentAt (profile : Profile) (instrument : Bool) : Bool :=
  if instrument then profile ⟨1, by decide⟩ else profile ⟨0, by decide⟩

def outcomeAt (profile : Profile) (treatment : Bool) : Bool :=
  if treatment then profile ⟨3, by decide⟩ else profile ⟨2, by decide⟩

/-- The factual observable assignment generated by a fixed instrument and
response profile.  The outcome reads the profile's actual treatment output. -/
def observedAssignment (instrument : Bool) (profile : Profile) : signature.Assignment :=
  fun node => if node.val = 0 then instrument
    else if node.val = 1 then treatmentAt profile instrument
    else outcomeAt profile (treatmentAt profile instrument)

def observedCell (instrument treatment outcome : Bool) : Event signature.Assignment :=
  fun sample => decide (sample z = instrument) &&
    (decide (sample x = treatment) && decide (sample y = outcome))

/-- A Boolean row of the observation matrix.  Every row coefficient is
zero or one before multiplication by the fixed instrument probability. -/
def responseCell (instrument treatment outcome : Bool) : Event Profile :=
  fun profile => decide (treatmentAt profile instrument = treatment) &&
    decide (outcomeAt profile treatment = outcome)

/-- The actual independent product record, pushed through profile evaluation.
Instrument and response records may have unrelated rational denominators. -/
def observedRecord (instrument : FiniteProbRecord Bool) (responses : FiniteProbRecord Profile) :
    FiniteProbRecord signature.Assignment :=
  (instrument.product responses).map (fun pair => observedAssignment pair.1 pair.2)

/-- An intervention on treatment leaves only the profile's corresponding
outcome response; the independent instrument then integrates out. -/
def effectRecord (responses : FiniteProbRecord Profile) (action : Bool) : FiniteProbRecord Bool :=
  responses.map (fun profile => outcomeAt profile action)

private theorem observedCell_rectangle (observedInstrument instrument treatment outcome : Bool)
    (profile : Profile) :
    observedCell instrument treatment outcome (observedAssignment observedInstrument profile) =
      (decide (observedInstrument = instrument) && responseCell instrument treatment outcome profile) := by
  change (decide (observedInstrument = instrument) &&
    (decide (treatmentAt profile observedInstrument = treatment) &&
      decide (outcomeAt profile (treatmentAt profile observedInstrument) = outcome))) = _
  -- Both tests compare supplied Boolean values.  Their constructive
  -- equality decisions do not decide an arbitrary semantic proposition.
  by_cases sameInstrument : observedInstrument = instrument
  · subst observedInstrument
    by_cases sameTreatment : treatmentAt profile instrument = treatment
    · simp [responseCell, sameTreatment]
    · simp [responseCell, sameTreatment]
  · simp only [sameInstrument, decide_false, Bool.false_and]

/-- Exact linear joint-cell equation, valid also when the instrument value
has probability zero.  No conditional probability is totalized at that value. -/
theorem observedRecord_cell (instrument : FiniteProbRecord Bool) (responses : FiniteProbRecord Profile)
    (instrumentValue treatment outcome : Bool) :
    QProb.Equiv ((observedRecord instrument responses).probVal (observedCell instrumentValue treatment outcome))
      (QProb.mul (instrument.probVal (FiniteProbRecord.singletonEvent instrumentValue))
        (responses.probVal (responseCell instrumentValue treatment outcome))) :=
  QProb.equiv_trans
    ((instrument.product responses).map_probVal (fun pair => observedAssignment pair.1 pair.2)
      (observedCell instrumentValue treatment outcome))
    (QProb.equiv_trans
      ((instrument.product responses).probVal_congr _ _ (fun pair =>
        observedCell_rectangle pair.1 instrumentValue treatment outcome pair.2))
      (instrument.product_probVal responses (FiniteProbRecord.singletonEvent instrumentValue)
        (responseCell instrumentValue treatment outcome)))

/-- The causal-event objective is another zero/one row on the same weights.
This is the forward linear objective; all-model coverage is a separate proof. -/
theorem effectRecord_probVal (responses : FiniteProbRecord Profile) (action : Bool) :
    QProb.Equiv ((effectRecord responses action).probVal id)
      (responses.probVal (fun profile => outcomeAt profile action)) :=
  responses.map_probVal (fun profile => outcomeAt profile action) id

end BinaryInstrumental
end Causality
end Thesis
