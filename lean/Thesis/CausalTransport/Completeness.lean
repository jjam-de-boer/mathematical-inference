          identifyFuel 0 G host q.outcome (NodeSet.inter q.action host)
            (chainProduct NodeSet.full host) =
            IdentificationOutcome.failed fail := by
        rw [← hn]
        exact hnested
      simp [identifyFuel] at hzero
