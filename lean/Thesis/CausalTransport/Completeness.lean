      have hsucc :
          identifyFuel (n + 1) G host q.outcome
            (NodeSet.inter q.action host)
            (chainProduct NodeSet.full host) =
            IdentificationOutcome.failed fail := by
        rw [← hn]
        exact hnested
      have hinter :
          NodeSet.inter (NodeSet.inter q.action host) host =
