            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome))) =
        component :: component2 :: rest)
    (hmem : piece ∈ component :: component2 :: rest)
    (_hnestedKept :
      NodeSet.equal
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                piece)
