          identifyFuel (n + 1) G larger piece
            (NodeSet.inter
              (NodeSet.inter (NodeSet.diff remaining piece) remaining)
              larger)
            (chainProduct remaining larger) =
            IdentificationOutcome.failed fail := by
        rw [← hm']
