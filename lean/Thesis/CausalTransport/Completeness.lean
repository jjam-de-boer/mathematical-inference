                (NodeSet.inter (NodeSet.diff host piece) host))
              (NodeSet.inter piece host)))
          (chainProduct
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)
            host)) =
        IdentificationOutcome.failed fail := by
  have hmem' :
      piece ∈ G.cComponents
        (NodeSet.diff host
          (NodeSet.inter
            (NodeSet.inter q.action
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
