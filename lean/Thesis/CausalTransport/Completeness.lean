            fail.remaining) i = true := by
        simpa [hfreeR] using hcut
      simp [NodeSet.diff, NodeSet.inter, NodeSet.full] at hi'
      cases hp : piece i with
      | true =>
          rfl
      | false =>
          cases hr : fail.remaining i with
          | false =>
              simp [hp, hr] at hi'
          | true =>
              simp [hp, hr] at hi'
    have hdisjP :=
      (NodeSet.disjointBool_eq_true_iff _ _).mp
