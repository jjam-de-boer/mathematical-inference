        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = true)
    (_hnestedFc :
      G.cComponents
        (NodeSet.diff
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
