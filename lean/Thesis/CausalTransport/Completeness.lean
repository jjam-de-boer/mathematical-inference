            host)) =
        component :: component2 :: rest)
    (hmem : piece ∈ component :: component2 :: rest)
    (hnestedKept :
      NodeSet.equal
        (G.ancestralSet host
          (GraphMutilation.bar
            (NodeSet.inter (NodeSet.diff host piece) host))
          (NodeSet.inter piece host))
        host = false)
    (hinner :
      Exists fun n =>
        identifyFuel n G host piece (NodeSet.diff host piece)
