    (hmem : piece ∈ component :: component2 :: rest)
    (_hnestedKept :
      NodeSet.equal
        (G.ancestralSet NodeSet.full
          (GraphMutilation.bar (NodeSet.diff NodeSet.full piece))
          (NodeSet.inter piece NodeSet.full))
