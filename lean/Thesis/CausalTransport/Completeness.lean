    (hfail : identifyJoint G q = IdentificationOutcome.failed fail)
    (heq : NodeSet.equal fail.remaining host = true)
    (hfreeEq : NodeSet.equal fail.free piece = true)
    (hancFree :
      NodeSet.equal
        (G.ancestralSet fail.remaining
