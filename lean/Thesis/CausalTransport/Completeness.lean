          q.outcome) = true)
    (hfc :
      G.cComponents
        (NodeSet.diff
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (NodeSet.inter q.action
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome))) =
        component :: component2 :: rest)
    (hmem : piece ∈ component :: component2 :: rest)
    (_hnestedKept :
      NodeSet.equal
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                piece)
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter piece
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)))
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = true)
    (_hnestedFc :
      G.cComponents
        (NodeSet.diff
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (NodeSet.inter
            (NodeSet.diff
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)
              piece)
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome))) =
        [piece])
    (_hsingle :
      G.isSingleCComponent
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = false)
    (_hany :
      (G.cComponents
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)).any
        (fun c => NodeSet.equal c piece) = false)
    (hcont :
      G.containingCComponent
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome)
        piece = some larger)
    (hexH :
      NodeSet.isEmpty (NodeSet.inter q.action larger) = false)
    (hfcL :
      G.cComponents
        (NodeSet.diff larger
          (NodeSet.inter
            (NodeSet.inter
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                piece)
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome))
            larger)) =
        inner :: inner2 :: innerRest)
    (hmemS : subpiece ∈ inner :: inner2 :: innerRest)
    (hfail : identifyJoint G q = IdentificationOutcome.failed fail)
    (heq : NodeSet.equal fail.remaining larger = true)
    (hfreeEq : NodeSet.equal fail.free subpiece = true)
    (hancFree :
      NodeSet.equal
        (G.ancestralSet fail.remaining
          (GraphMutilation.bar
            (NodeSet.diff fail.remaining fail.free))
          (NodeSet.inter fail.free fail.remaining))
        fail.remaining = true)
    (hancY :
      NodeSet.equal
        (G.ancestralSet fail.remaining (GraphMutilation.bar q.action)
          (NodeSet.inter q.outcome fail.remaining))
        fail.remaining = true) :
    Exists fun witness => hedgeWitness? G q fail = some witness := by
  let kept :=
    G.ancestralSet NodeSet.full (GraphMutilation.bar q.action) q.outcome
  have heqR := (NodeSet.equal_eq_true_iff _ _).mp heq
  have hpiece := (NodeSet.equal_eq_true_iff _ _).mp hfreeEq
  have hmem' :
      piece ∈ G.cComponents
        (NodeSet.diff kept (NodeSet.inter q.action kept)) := by
    have hfc' :
        G.cComponents
          (NodeSet.diff kept (NodeSet.inter q.action kept)) =
          component :: component2 :: rest := by
      simpa [kept] using hfc
    rw [hfc']
    exact hmem
  have hmemS' :
      subpiece ∈ G.cComponents
        (NodeSet.diff larger
          (NodeSet.inter
            (NodeSet.inter (NodeSet.diff kept piece) kept)
            larger)) := by
    have hfcL' :
        G.cComponents
          (NodeSet.diff larger
            (NodeSet.inter
              (NodeSet.inter (NodeSet.diff kept piece) kept)
              larger)) =
          inner :: inner2 :: innerRest := by
      simpa [kept] using hfcL
    rw [hfcL']
    exact hmemS
  have hhost : NodeSet.Subset larger kept :=
    containingCComponent_subset_host G kept piece
      (by simpa [kept] using hcont)
  have hdisj :
      NodeSet.disjointBool (failedHedgeSelection fail).small q.action =
        true := by
    refine (NodeSet.disjointBool_eq_true_iff _ _).mpr ?_
    intro i hi
    have hfreeS :
        NodeSet.diff larger
          (NodeSet.inter
            (NodeSet.inter (NodeSet.diff kept piece) kept)
            larger) i = true :=
      cComponents_subset G _ hmemS' i (by
        simpa [failedHedgeSelection, hpiece] using hi)
    cases ha : q.action i with
    | false =>
        rfl
    | true =>
        have hpieceA : piece i = false := by
          cases hp : piece i with
          | false =>
              rfl
          | true =>
              have hfreeP :
                  NodeSet.diff kept (NodeSet.inter q.action kept) i =
                    true :=
                cComponents_subset G _ hmem' i hp
              simp [NodeSet.diff, NodeSet.inter, ha] at hfreeP
        simp [NodeSet.diff, NodeSet.inter, hpieceA] at hfreeS
        cases hl : larger i with
        | false =>
            simp [hl] at hfreeS
        | true =>
            have hk : kept i = true := hhost i hl
            simp [hl, hk] at hfreeS
  have hmeets :
      NodeSet.meetsBool (failedHedgeSelection fail).large q.action =
        true := by
    rcases (NodeSet.isEmpty_eq_false_iff _).mp hexH with ⟨i, hi⟩
    refine (NodeSet.meetsBool_eq_true_iff _ _).mpr ?_
    refine ⟨i, ?_, ?_⟩
    · simpa [failedHedgeSelection, heqR, NodeSet.inter] using
        (Bool.and_eq_true_iff.mp (by simpa [NodeSet.inter] using hi)).2
    · exact (Bool.and_eq_true_iff.mp (by simpa [NodeSet.inter] using hi)).1
  exact hedgeWitness?_eq_some_of_failed_free_ancestral G q hfail hmeets
    hdisj hancFree hancY

/--
After a first ancestral shrink and nested product split, a further
ancestral shrink unpacks as the ID run on `An(piece)` inside that
ancestral remaining set, with action `kept \ piece`.
-/
theorem identifyJoint_eq_failed_of_first_shrink_product_shrink
    (G : ObservedGraph S) (q : JointKernelQuery S)
    {fail : IdentificationFail S}
    {component component2 : NodeSet S} {rest : List (NodeSet S)}
    {piece : NodeSet S}
    (_hex : NodeSet.isEmpty q.action = false)
    (_hkept :
      NodeSet.equal
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome)
        NodeSet.full = false)
    (hexN :
      NodeSet.isEmpty
        (NodeSet.inter q.action
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)) = false)
    (_hkeptN :
      NodeSet.equal
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter q.action
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter q.outcome
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)))
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = true)
    (hfc :
      G.cComponents
        (NodeSet.diff
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (NodeSet.inter q.action
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome))) =
        component :: component2 :: rest)
    (hmem : piece ∈ component :: component2 :: rest)
    (hnestedKept :
      NodeSet.equal
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                piece)
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter piece
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)))
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = false)
    (hinner :
      Exists fun n =>
        identifyFuel n G
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          piece
          (NodeSet.diff
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)
            piece)
          (.marginalize
            (NodeSet.diff NodeSet.full
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome))
            (observationalJointTerm S)) =
          IdentificationOutcome.failed fail)
    (_hfail : identifyJoint G q = IdentificationOutcome.failed fail) :
    Exists fun n =>
      identifyFuel n G
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                piece)
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter piece
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)))
        piece
        (NodeSet.diff
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          piece)
        (.marginalize
          (NodeSet.diff
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)
            (G.ancestralSet
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)
              (GraphMutilation.bar
                (NodeSet.inter
                  (NodeSet.diff
                    (G.ancestralSet NodeSet.full
                      (GraphMutilation.bar q.action) q.outcome)
                    piece)
                  (G.ancestralSet NodeSet.full
                    (GraphMutilation.bar q.action) q.outcome)))
              (NodeSet.inter piece
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome))))
          (.marginalize
            (NodeSet.diff NodeSet.full
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome))
            (observationalJointTerm S))) =
        IdentificationOutcome.failed fail := by
  let kept :=
    G.ancestralSet NodeSet.full (GraphMutilation.bar q.action) q.outcome
  have hmem' :
      piece ∈ G.cComponents
        (NodeSet.diff kept (NodeSet.inter q.action kept)) := by
    have hfc' :
        G.cComponents
          (NodeSet.diff kept (NodeSet.inter q.action kept)) =
          component :: component2 :: rest := by
      simpa [kept] using hfc
    rw [hfc']
    exact hmem
  have hexP :
      NodeSet.isEmpty
        (NodeSet.inter (NodeSet.diff kept piece) kept) = false := by
    rcases (NodeSet.isEmpty_eq_false_iff _).mp
        (show NodeSet.isEmpty (NodeSet.inter q.action kept) = false by
          simpa [kept] using hexN) with ⟨i, hi⟩
    have hpair : q.action i = true ∧ kept i = true :=
      Bool.and_eq_true_iff.mp (by simpa [NodeSet.inter] using hi)
    have hdisj : NodeSet.disjointBool piece q.action = true :=
      (NodeSet.disjointBool_eq_true_iff _ _).mpr (fun j hj => by
        have hfreeJ :
            NodeSet.diff kept (NodeSet.inter q.action kept) j = true :=
          cComponents_subset G _ hmem' j hj
        cases ha : q.action j with
        | false =>
            rfl
        | true =>
            simp [NodeSet.diff, NodeSet.inter, ha] at hfreeJ)
    have hnot : piece i = false := by
      cases hp : piece i with
      | false =>
          rfl
      | true =>
          exact (Bool.false_ne_true
            (((NodeSet.disjointBool_eq_true_iff _ _).mp hdisj i hp).symm.trans
              hpair.1)).elim
    exact (NodeSet.isEmpty_eq_false_iff _).mpr
      ⟨i, by simp [NodeSet.diff, NodeSet.inter, hnot, hpair.2]⟩
  exact identifyFuel_eq_failed_of_product_piece_shrink G kept piece
    (.marginalize
      (NodeSet.diff NodeSet.full kept) (observationalJointTerm S))
    hexP
    (by simpa [kept] using hnestedKept)
    (by simpa [kept] using hinner)

/--
A first ancestral shrink, nested product split, then ancestral shrink
of that piece, with remaining `An(piece)` inside the first ancestral
set and free side the piece, yields a hedge for the original query once
that smaller remaining set meets `X` and is ancestral of `Y` in
`G_{\overline{X}}`.
-/
theorem hedgeWitness?_eq_some_of_failed_after_shrink_product_shrink
    (G : ObservedGraph S) (q : JointKernelQuery S)
    {fail : IdentificationFail S}
    {component component2 : NodeSet S} {rest : List (NodeSet S)}
    {piece : NodeSet S}
    (_hex : NodeSet.isEmpty q.action = false)
    (_hkept :
      NodeSet.equal
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome)
        NodeSet.full = false)
    (hexN :
      NodeSet.isEmpty
        (NodeSet.inter q.action
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)) = false)
    (_hkeptN :
      NodeSet.equal
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter q.action
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter q.outcome
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)))
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = true)
    (hfc :
      G.cComponents
        (NodeSet.diff
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (NodeSet.inter q.action
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome))) =
        component :: component2 :: rest)
    (hmem : piece ∈ component :: component2 :: rest)
    (hnestedKept :
      NodeSet.equal
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                piece)
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter piece
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)))
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = false)
    (hexK :
      NodeSet.isEmpty
        (NodeSet.inter q.action
          (G.ancestralSet
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)
            (GraphMutilation.bar
              (NodeSet.inter
                (NodeSet.diff
                  (G.ancestralSet NodeSet.full
                    (GraphMutilation.bar q.action) q.outcome)
                  piece)
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)))
            (NodeSet.inter piece
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))) = false)
    (hinner :
      Exists fun n =>
        identifyFuel n G
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          piece
          (NodeSet.diff
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)
            piece)
          (.marginalize
            (NodeSet.diff NodeSet.full
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome))
            (observationalJointTerm S)) =
          IdentificationOutcome.failed fail)
    (hfail : identifyJoint G q = IdentificationOutcome.failed fail)
    (heq :
      NodeSet.equal fail.remaining
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                piece)
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter piece
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome))) = true)
    (hfree :
      NodeSet.equal fail.free
        (NodeSet.diff fail.remaining
          (NodeSet.inter
            (NodeSet.diff
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)
              piece)
            fail.remaining)) = true)
    (hancY :
      NodeSet.equal
        (G.ancestralSet fail.remaining (GraphMutilation.bar q.action)
          (NodeSet.inter q.outcome fail.remaining))
        fail.remaining = true) :
    Exists fun witness => hedgeWitness? G q fail = some witness := by
  let kept :=
    G.ancestralSet NodeSet.full (GraphMutilation.bar q.action) q.outcome
  let nestedAn :=
    G.ancestralSet kept
      (GraphMutilation.bar
        (NodeSet.inter (NodeSet.diff kept piece) kept))
      (NodeSet.inter piece kept)
  have hmem' :
      piece ∈ G.cComponents
        (NodeSet.diff kept (NodeSet.inter q.action kept)) := by
    have hfc' :
        G.cComponents
          (NodeSet.diff kept (NodeSet.inter q.action kept)) =
          component :: component2 :: rest := by
      simpa [kept] using hfc
    rw [hfc']
    exact hmem
  have hexP :
      NodeSet.isEmpty
        (NodeSet.inter (NodeSet.diff kept piece) kept) = false := by
    rcases (NodeSet.isEmpty_eq_false_iff _).mp
        (show NodeSet.isEmpty (NodeSet.inter q.action kept) = false by
          simpa [kept] using hexN) with ⟨i, hi⟩
    have hpair : q.action i = true ∧ kept i = true :=
      Bool.and_eq_true_iff.mp (by simpa [NodeSet.inter] using hi)
    have hdisjP : NodeSet.disjointBool piece q.action = true :=
      (NodeSet.disjointBool_eq_true_iff _ _).mpr (fun j hj => by
        have hfreeJ :
            NodeSet.diff kept (NodeSet.inter q.action kept) j = true :=
          cComponents_subset G _ hmem' j hj
        cases ha : q.action j with
        | false =>
            rfl
        | true =>
            simp [NodeSet.diff, NodeSet.inter, ha] at hfreeJ)
    have hnot : piece i = false := by
      cases hp : piece i with
      | false =>
          rfl
      | true =>
          exact (Bool.false_ne_true
            (((NodeSet.disjointBool_eq_true_iff _ _).mp hdisjP i hp).symm.trans
              hpair.1)).elim
    exact (NodeSet.isEmpty_eq_false_iff _).mpr
      ⟨i, by simp [NodeSet.diff, NodeSet.inter, hnot, hpair.2]⟩
  have hrestricted :=
    identifyFuel_eq_failed_of_product_piece_shrink G kept piece
      (.marginalize
        (NodeSet.diff NodeSet.full kept) (observationalJointTerm S))
      hexP
      (by simpa [kept] using hnestedKept)
      (by simpa [kept] using hinner)
  have heqR := (NodeSet.equal_eq_true_iff _ _).mp heq
  have hpieceSub : NodeSet.Subset piece kept :=
    NodeSet.Subset.trans
      (cComponents_subset G _ hmem')
      (NodeSet.diff_subset_left _ _)
  have hfreeEq :
      NodeSet.equal fail.free piece = true := by
    have hcut :
        NodeSet.diff fail.remaining
            (NodeSet.inter (NodeSet.diff kept piece) fail.remaining) =
          piece := by
      funext i
      have hAn : fail.remaining i = nestedAn i := by
        simpa [nestedAn, kept] using
          (congrArg (fun s => s i) heqR)
      cases hp : piece i with
      | true =>
          have hk : kept i = true := hpieceSub i hp
          have htargets : NodeSet.inter piece kept i = true := by
            simp [NodeSet.inter, hp, hk]
          have hrem : fail.remaining i = true := by
            rw [hAn]
            exact ancestralSet_contains_targets G kept
              (GraphMutilation.bar
                (NodeSet.inter (NodeSet.diff kept piece) kept))
              (NodeSet.inter piece kept) hk htargets
          simp [NodeSet.diff, NodeSet.inter, hp, hrem]
      | false =>
          cases hr : fail.remaining i with
          | false =>
              simp [NodeSet.diff, NodeSet.inter, hp, hr]
          | true =>
              have hk : kept i = true :=
                ancestralSet_subset G kept
                  (GraphMutilation.bar
                    (NodeSet.inter (NodeSet.diff kept piece) kept))
                  (NodeSet.inter piece kept) i (by
                    simpa [nestedAn, hAn] using hr)
              simp [NodeSet.diff, NodeSet.inter, hp, hr, hk]
    have hfreeR := (NodeSet.equal_eq_true_iff _ _).mp hfree
    exact (NodeSet.equal_eq_true_iff _ _).mpr
      (hfreeR.trans (by simpa [kept] using hcut))
  have hfree' :
      NodeSet.equal fail.free
        (NodeSet.diff fail.remaining
          (NodeSet.inter (NodeSet.diff kept piece) fail.remaining)) =
        true := by
    simpa [kept] using hfree
  rcases hrestricted with ⟨n, hn⟩
  have hancFree :=
    identifyFuel_eq_failed_query_of_remaining_eq n G nestedAn piece
      (NodeSet.diff kept piece)
      (.marginalize
        (NodeSet.diff kept nestedAn)
        (.marginalize
          (NodeSet.diff NodeSet.full kept) (observationalJointTerm S)))
      (by simpa [nestedAn, kept] using hn) (by simpa [nestedAn, kept] using heq)
      hfree'
  have hancFree' :
      NodeSet.equal
        (G.ancestralSet fail.remaining
          (GraphMutilation.bar
            (NodeSet.diff fail.remaining fail.free))
          (NodeSet.inter fail.free fail.remaining))
        fail.remaining = true := by
    have hfreeR := (NodeSet.equal_eq_true_iff _ _).mp hfreeEq
    simpa [hfreeR] using hancFree
  have hdisj :
      NodeSet.disjointBool (failedHedgeSelection fail).small q.action =
        true := by
    refine (NodeSet.disjointBool_eq_true_iff _ _).mpr ?_
    intro i hi
    have hfreeI :
        NodeSet.diff kept (NodeSet.inter q.action kept) i = true :=
      cComponents_subset G _ hmem' i (by
        simpa [failedHedgeSelection, (NodeSet.equal_eq_true_iff _ _).mp
          hfreeEq] using hi)
    cases ha : q.action i with
    | false =>
        rfl
    | true =>
        simp [NodeSet.diff, NodeSet.inter, ha] at hfreeI
  have hmeets :
      NodeSet.meetsBool (failedHedgeSelection fail).large q.action =
        true := by
    rcases (NodeSet.isEmpty_eq_false_iff _).mp
        (show NodeSet.isEmpty (NodeSet.inter q.action nestedAn) = false by
          simpa [nestedAn, kept] using hexK) with ⟨i, hi⟩
    refine (NodeSet.meetsBool_eq_true_iff _ _).mpr ?_
    refine ⟨i, ?_, ?_⟩
    · simpa [failedHedgeSelection, heqR, nestedAn, kept, NodeSet.inter] using
        (Bool.and_eq_true_iff.mp (by simpa [NodeSet.inter] using hi)).2
    · exact (Bool.and_eq_true_iff.mp (by simpa [NodeSet.inter] using hi)).1
  exact hedgeWitness?_eq_some_of_failed_free_ancestral G q hfail hmeets
    hdisj hancFree' hancY

/--
After a first ancestral shrink, nested product split, and ancestral
shrink of that piece, a further product split unpacks as an ID run on
one free c-component of `An(piece)`, with action `An(piece) \ subpiece`.
-/
theorem identifyJoint_eq_failed_of_first_shrink_product_shrink_product
    (G : ObservedGraph S) (q : JointKernelQuery S)
    {fail : IdentificationFail S}
    {component component2 : NodeSet S} {rest : List (NodeSet S)}
    {inner inner2 : NodeSet S} {innerRest : List (NodeSet S)}
    {piece : NodeSet S}
    (_hex : NodeSet.isEmpty q.action = false)
    (_hkept :
      NodeSet.equal
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome)
        NodeSet.full = false)
    (hexN :
      NodeSet.isEmpty
        (NodeSet.inter q.action
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)) = false)
    (_hkeptN :
      NodeSet.equal
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter q.action
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter q.outcome
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)))
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = true)
    (hfc :
      G.cComponents
        (NodeSet.diff
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (NodeSet.inter q.action
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome))) =
        component :: component2 :: rest)
    (hmem : piece ∈ component :: component2 :: rest)
    (hnestedKept :
      NodeSet.equal
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                piece)
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter piece
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)))
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = false)
    (hexP2 :
      NodeSet.isEmpty
        (NodeSet.inter
          (NodeSet.diff
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)
            piece)
          (G.ancestralSet
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)
            (GraphMutilation.bar
              (NodeSet.inter
                (NodeSet.diff
                  (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                    q.outcome)
                  piece)
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)))
            (NodeSet.inter piece
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))) = false)
    (hkeptP :
      NodeSet.equal
        (G.ancestralSet
          (G.ancestralSet
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)
            (GraphMutilation.bar
              (NodeSet.inter
                (NodeSet.diff
                  (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                    q.outcome)
                  piece)
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)))
            (NodeSet.inter piece
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (GraphMutilation.bar
            (NodeSet.inter
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                piece)
              (G.ancestralSet
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                (GraphMutilation.bar
                  (NodeSet.inter
                    (NodeSet.diff
                      (G.ancestralSet NodeSet.full
                        (GraphMutilation.bar q.action) q.outcome)
                      piece)
                    (G.ancestralSet NodeSet.full
                      (GraphMutilation.bar q.action) q.outcome)))
                (NodeSet.inter piece
                  (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                    q.outcome)))))
          (NodeSet.inter piece
            (G.ancestralSet
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)
              (GraphMutilation.bar
                (NodeSet.inter
                  (NodeSet.diff
                    (G.ancestralSet NodeSet.full
                      (GraphMutilation.bar q.action) q.outcome)
                    piece)
                  (G.ancestralSet NodeSet.full
                    (GraphMutilation.bar q.action) q.outcome)))
              (NodeSet.inter piece
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)))))
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                piece)
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter piece
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome))) = true)
    (hfcP :
      G.cComponents
        (NodeSet.diff
          (G.ancestralSet
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)
            (GraphMutilation.bar
              (NodeSet.inter
                (NodeSet.diff
                  (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                    q.outcome)
                  piece)
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)))
            (NodeSet.inter piece
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter
            (NodeSet.diff
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)
              piece)
            (G.ancestralSet
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)
              (GraphMutilation.bar
                (NodeSet.inter
                  (NodeSet.diff
                    (G.ancestralSet NodeSet.full
                      (GraphMutilation.bar q.action) q.outcome)
                    piece)
                  (G.ancestralSet NodeSet.full
                    (GraphMutilation.bar q.action) q.outcome)))
              (NodeSet.inter piece
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome))))) =
        inner :: inner2 :: innerRest)
    (hinner :
      Exists fun n =>
        identifyFuel n G
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          piece
          (NodeSet.diff
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)
            piece)
          (.marginalize
            (NodeSet.diff NodeSet.full
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome))
            (observationalJointTerm S)) =
          IdentificationOutcome.failed fail)
    (_hfail : identifyJoint G q = IdentificationOutcome.failed fail) :
    Exists fun subpiece =>
      subpiece ∈ inner :: inner2 :: innerRest ∧
        Exists fun n =>
          identifyFuel n G
            (G.ancestralSet
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)
              (GraphMutilation.bar
                (NodeSet.inter
                  (NodeSet.diff
                    (G.ancestralSet NodeSet.full
                      (GraphMutilation.bar q.action) q.outcome)
                    piece)
                  (G.ancestralSet NodeSet.full
                    (GraphMutilation.bar q.action) q.outcome)))
              (NodeSet.inter piece
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)))
            subpiece
            (NodeSet.diff
              (G.ancestralSet
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                (GraphMutilation.bar
                  (NodeSet.inter
                    (NodeSet.diff
                      (G.ancestralSet NodeSet.full
                        (GraphMutilation.bar q.action) q.outcome)
                      piece)
                    (G.ancestralSet NodeSet.full
                      (GraphMutilation.bar q.action) q.outcome)))
                (NodeSet.inter piece
                  (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                    q.outcome)))
              subpiece)
            (.marginalize
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                (G.ancestralSet
                  (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                    q.outcome)
                  (GraphMutilation.bar
                    (NodeSet.inter
                      (NodeSet.diff
                        (G.ancestralSet NodeSet.full
                          (GraphMutilation.bar q.action) q.outcome)
                        piece)
                      (G.ancestralSet NodeSet.full
                        (GraphMutilation.bar q.action) q.outcome)))
                  (NodeSet.inter piece
                    (G.ancestralSet NodeSet.full
                      (GraphMutilation.bar q.action) q.outcome))))
              (.marginalize
                (NodeSet.diff NodeSet.full
                  (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                    q.outcome))
                (observationalJointTerm S))) =
            IdentificationOutcome.failed fail := by
  let kept :=
    G.ancestralSet NodeSet.full (GraphMutilation.bar q.action) q.outcome
  have hmem' :
      piece ∈ G.cComponents
        (NodeSet.diff kept (NodeSet.inter q.action kept)) := by
    have hfc' :
        G.cComponents
          (NodeSet.diff kept (NodeSet.inter q.action kept)) =
          component :: component2 :: rest := by
      simpa [kept] using hfc
    rw [hfc']
    exact hmem
  have hexP :
      NodeSet.isEmpty
        (NodeSet.inter (NodeSet.diff kept piece) kept) = false := by
    rcases (NodeSet.isEmpty_eq_false_iff _).mp
        (show NodeSet.isEmpty (NodeSet.inter q.action kept) = false by
          simpa [kept] using hexN) with ⟨i, hi⟩
    have hpair : q.action i = true ∧ kept i = true :=
      Bool.and_eq_true_iff.mp (by simpa [NodeSet.inter] using hi)
    have hdisj : NodeSet.disjointBool piece q.action = true :=
      (NodeSet.disjointBool_eq_true_iff _ _).mpr (fun j hj => by
        have hfreeJ :
            NodeSet.diff kept (NodeSet.inter q.action kept) j = true :=
          cComponents_subset G _ hmem' j hj
        cases ha : q.action j with
        | false =>
            rfl
        | true =>
            simp [NodeSet.diff, NodeSet.inter, ha] at hfreeJ)
    have hnot : piece i = false := by
      cases hp : piece i with
      | false =>
          rfl
      | true =>
          exact (Bool.false_ne_true
            (((NodeSet.disjointBool_eq_true_iff _ _).mp hdisj i hp).symm.trans
              hpair.1)).elim
    exact (NodeSet.isEmpty_eq_false_iff _).mpr
      ⟨i, by simp [NodeSet.diff, NodeSet.inter, hnot, hpair.2]⟩
  exact identifyFuel_eq_failed_of_product_piece_shrink_product G kept piece
    (.marginalize
      (NodeSet.diff NodeSet.full kept) (observationalJointTerm S))
    hexP
    (by simpa [kept] using hnestedKept)
    (by simpa [kept] using hexP2)
    (by simpa [kept] using hkeptP)
    (by simpa [kept] using hfcP)
    (by simpa [kept] using hinner)

/--
A first ancestral shrink, nested product, ancestral shrink of that
piece, then a further product split, with remaining `An(piece)` and
free side the failing subpiece, yields a hedge for the original query
once that ancestral set meets `X` and is ancestral of `Y` in
`G_{\overline{X}}`.
-/
theorem hedgeWitness?_eq_some_of_failed_after_shrink_product_shrink_product
    (G : ObservedGraph S) (q : JointKernelQuery S)
    {fail : IdentificationFail S}
    {component component2 : NodeSet S} {rest : List (NodeSet S)}
    {inner inner2 : NodeSet S} {innerRest : List (NodeSet S)}
    {piece subpiece : NodeSet S}
    (_hex : NodeSet.isEmpty q.action = false)
    (_hkept :
      NodeSet.equal
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome)
        NodeSet.full = false)
    (_hexN :
      NodeSet.isEmpty
        (NodeSet.inter q.action
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)) = false)
    (_hkeptN :
      NodeSet.equal
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter q.action
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter q.outcome
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)))
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = true)
    (hfc :
      G.cComponents
        (NodeSet.diff
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (NodeSet.inter q.action
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome))) =
        component :: component2 :: rest)
    (hmem : piece ∈ component :: component2 :: rest)
    (_hnestedKept :
      NodeSet.equal
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                piece)
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter piece
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)))
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = false)
    (hexK :
      NodeSet.isEmpty
        (NodeSet.inter q.action
          (G.ancestralSet
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)
            (GraphMutilation.bar
              (NodeSet.inter
                (NodeSet.diff
                  (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                    q.outcome)
                  piece)
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)))
            (NodeSet.inter piece
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))) = false)
    (hfcP :
      G.cComponents
        (NodeSet.diff
          (G.ancestralSet
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)
            (GraphMutilation.bar
              (NodeSet.inter
                (NodeSet.diff
                  (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                    q.outcome)
                  piece)
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)))
            (NodeSet.inter piece
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter
            (NodeSet.diff
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)
              piece)
            (G.ancestralSet
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)
              (GraphMutilation.bar
                (NodeSet.inter
                  (NodeSet.diff
                    (G.ancestralSet NodeSet.full
                      (GraphMutilation.bar q.action) q.outcome)
                    piece)
                  (G.ancestralSet NodeSet.full
                    (GraphMutilation.bar q.action) q.outcome)))
              (NodeSet.inter piece
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome))))) =
        inner :: inner2 :: innerRest)
    (hmemS : subpiece ∈ inner :: inner2 :: innerRest)
    (hfail : identifyJoint G q = IdentificationOutcome.failed fail)
    (heq :
      NodeSet.equal fail.remaining
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter
              (NodeSet.diff
                (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                  q.outcome)
                piece)
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter piece
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome))) = true)
    (hfreeEq : NodeSet.equal fail.free subpiece = true)
    (hancFree :
      NodeSet.equal
        (G.ancestralSet fail.remaining
          (GraphMutilation.bar
            (NodeSet.diff fail.remaining fail.free))
          (NodeSet.inter fail.free fail.remaining))
        fail.remaining = true)
    (hancY :
      NodeSet.equal
        (G.ancestralSet fail.remaining (GraphMutilation.bar q.action)
          (NodeSet.inter q.outcome fail.remaining))
        fail.remaining = true) :
    Exists fun witness => hedgeWitness? G q fail = some witness := by
  let kept :=
    G.ancestralSet NodeSet.full (GraphMutilation.bar q.action) q.outcome
  let nestedAn :=
    G.ancestralSet kept
      (GraphMutilation.bar
        (NodeSet.inter (NodeSet.diff kept piece) kept))
      (NodeSet.inter piece kept)
  have heqR := (NodeSet.equal_eq_true_iff _ _).mp heq
  have hpiece := (NodeSet.equal_eq_true_iff _ _).mp hfreeEq
  have hmem' :
      piece ∈ G.cComponents
        (NodeSet.diff kept (NodeSet.inter q.action kept)) := by
    have hfc' :
        G.cComponents
          (NodeSet.diff kept (NodeSet.inter q.action kept)) =
          component :: component2 :: rest := by
      simpa [kept] using hfc
    rw [hfc']
    exact hmem
  have hmemS' :
      subpiece ∈ G.cComponents
        (NodeSet.diff nestedAn
          (NodeSet.inter (NodeSet.diff kept piece) nestedAn)) := by
    have hfcP' :
        G.cComponents
          (NodeSet.diff nestedAn
            (NodeSet.inter (NodeSet.diff kept piece) nestedAn)) =
          inner :: inner2 :: innerRest := by
      simpa [nestedAn, kept] using hfcP
    rw [hfcP']
    exact hmemS
  have hhost : NodeSet.Subset nestedAn kept :=
    ancestralSet_subset G kept
      (GraphMutilation.bar
        (NodeSet.inter (NodeSet.diff kept piece) kept))
      (NodeSet.inter piece kept)
  have hdisj :
      NodeSet.disjointBool (failedHedgeSelection fail).small q.action =
        true := by
    refine (NodeSet.disjointBool_eq_true_iff _ _).mpr ?_
    intro i hi
    have hfreeS :
        NodeSet.diff nestedAn
          (NodeSet.inter (NodeSet.diff kept piece) nestedAn) i = true :=
      cComponents_subset G _ hmemS' i (by
        simpa [failedHedgeSelection, hpiece] using hi)
    cases ha : q.action i with
    | false =>
        rfl
    | true =>
        have hpieceA : piece i = false := by
          cases hp : piece i with
          | false =>
              rfl
          | true =>
              have hfreeP :
                  NodeSet.diff kept (NodeSet.inter q.action kept) i =
                    true :=
                cComponents_subset G _ hmem' i hp
              simp [NodeSet.diff, NodeSet.inter, ha] at hfreeP
        simp [NodeSet.diff, NodeSet.inter, hpieceA] at hfreeS
        cases hl : nestedAn i with
        | false =>
            simp [hl] at hfreeS
        | true =>
            have hk : kept i = true := hhost i hl
            simp [hl, hk] at hfreeS
  have hmeets :
      NodeSet.meetsBool (failedHedgeSelection fail).large q.action =
        true := by
    rcases (NodeSet.isEmpty_eq_false_iff _).mp
        (show NodeSet.isEmpty (NodeSet.inter q.action nestedAn) = false by
          simpa [nestedAn, kept] using hexK) with ⟨i, hi⟩
    refine (NodeSet.meetsBool_eq_true_iff _ _).mpr ?_
    refine ⟨i, ?_, ?_⟩
    · simpa [failedHedgeSelection, heqR, nestedAn, kept, NodeSet.inter] using
        (Bool.and_eq_true_iff.mp (by simpa [NodeSet.inter] using hi)).2
    · exact (Bool.and_eq_true_iff.mp (by simpa [NodeSet.inter] using hi)).1
  exact hedgeWitness?_eq_some_of_failed_free_ancestral G q hfail hmeets
    hdisj hancFree hancY

/--
After a first ancestral shrink, a nested 4.3 restriction unpacks as the
ID run on the containing c-component of the ancestral remaining set,
with action `X ∩ host`.
-/
theorem identifyJoint_eq_failed_of_first_shrink_restrict
    (G : ObservedGraph S) (q : JointKernelQuery S)
    {fail : IdentificationFail S} {host seed : NodeSet S}
    (hex : NodeSet.isEmpty q.action = false)
    (hkept :
      NodeSet.equal
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome)
        NodeSet.full = false)
    (hexN :
      NodeSet.isEmpty
        (NodeSet.inter q.action
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)) = false)
    (hkeptN :
      NodeSet.equal
        (G.ancestralSet
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (GraphMutilation.bar
            (NodeSet.inter q.action
              (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
                q.outcome)))
          (NodeSet.inter q.outcome
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome)))
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = true)
    (hfc :
      G.cComponents
        (NodeSet.diff
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          (NodeSet.inter q.action
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome))) =
        [seed])
    (hsingle :
      G.isSingleCComponent
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome) = false)
    (hany :
      (G.cComponents
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)).any
        (fun piece => NodeSet.equal piece seed) = false)
    (hcont :
      G.containingCComponent
        (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
          q.outcome)
        seed = some host)
    (hfail : identifyJoint G q = IdentificationOutcome.failed fail) :
    Exists fun n =>
      identifyFuel n G host q.outcome
        (NodeSet.inter
          (NodeSet.inter q.action
            (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
              q.outcome))
          host)
        (chainProduct
          (G.ancestralSet NodeSet.full (GraphMutilation.bar q.action)
            q.outcome)
          host) =
        IdentificationOutcome.failed fail := by
  let kept :=
    G.ancestralSet NodeSet.full (GraphMutilation.bar q.action) q.outcome
  have hnested :
      identifyFuel
          (S.count * Nat.succ S.count * Nat.succ S.count) G kept
          q.outcome q.action
          (.marginalize
            (NodeSet.diff NodeSet.full kept) (observationalJointTerm S)) =
        IdentificationOutcome.failed fail :=
    identifyJoint_eq_failed_of_first_shrink G q hex hkept hfail
  cases hn : S.count * Nat.succ S.count * Nat.succ S.count with
  | zero =>
      have hzero :
