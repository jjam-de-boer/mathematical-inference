              (NodeSet.inter q.outcome host))))
        (G.ancestralSet host
          (GraphMutilation.bar (NodeSet.inter q.action host))
          (NodeSet.inter q.outcome host)) = true)
    (hfc :
      G.cComponents
        (NodeSet.diff
          (G.ancestralSet host
            (GraphMutilation.bar (NodeSet.inter q.action host))
            (NodeSet.inter q.outcome host))
          (NodeSet.inter (NodeSet.inter q.action host)
